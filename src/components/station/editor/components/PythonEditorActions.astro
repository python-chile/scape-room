<footer
  class="border-line-soft bg-paper flex flex-wrap items-center gap-3 border-t px-4 py-4 sm:px-5"
>
  <button
    type="button"
    disabled
    class="bg-accent text-ink shadow-action hover:bg-accent-dark focus-visible:outline-brand inline-flex min-h-12 items-center gap-3 px-5 py-3 font-bold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
    aria-label="Ejecutar código"
    data-python-run
    data-running="false"
  >
    <span aria-hidden="true" data-python-run-idle-icon>▶</span>
    <span data-python-run-idle-label>Ejecutar código</span>

    <span hidden aria-hidden="true" data-python-run-stop-icon>■</span>
    <span hidden data-python-run-stop-label>Detener ejecución</span>
  </button>

  <button
    type="button"
    class="border-brand text-brand hover:bg-brand hover:text-paper focus-visible:outline-brand inline-flex min-h-12 items-center gap-2 border px-4 font-bold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
    data-python-reset
  >
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M3 12a9 9 0 1 0 3-6.7"></path>
      <path d="M3 4v5h5"></path>
    </svg>

    <span>Restablecer código</span>
  </button>

  <label
    class="text-muted hover:bg-ink/5 hover:text-ink flex min-h-12 cursor-pointer items-center gap-2 px-3 text-sm font-medium transition-colors"
    title="Mostrar explicaciones sencillas para errores comunes de Python"
  >
    <span
      class="border-muted grid size-5 place-items-center rounded-full border font-mono text-xs"
      aria-hidden="true"
    >
      ?
    </span>

    <input
      type="checkbox"
      class="accent-brand size-4"
      data-python-error-help-toggle
    />

    <span>Explicar errores</span>
  </label>

  <label
    class="text-muted hover:bg-ink/5 hover:text-ink flex min-h-12 cursor-pointer items-center gap-2 px-3 text-sm font-medium transition-colors"
    title="Reproducir un sonido al resolver correctamente el desafío"
  >
    <input
      type="checkbox"
      class="accent-brand size-4"
      data-python-success-sound-toggle
    />

    <span>Sonido</span>
  </label>

  <kbd
    class="border-line text-muted ml-auto hidden rounded border px-3 py-2 font-mono text-xs sm:inline"
  >
    Ctrl/⌘ + Enter
  </kbd>

  <a
    hidden
    class="text-brand decoration-accent hover:text-brand-dark px-2 py-2 font-bold underline decoration-2 underline-offset-4 transition-colors"
    data-python-next></a>
</footer>
